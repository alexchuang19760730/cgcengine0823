# ============================================================
# Terminal-Bench × gemma4 × prime-agent 评估-学习循环 配置
# 所有脚本 source 本文件。在 M4 上运行前先按实际环境修改。
# ============================================================

# 必须先定义：后面的 freebuff2api key 读取 / 路径派生都依赖它（本文件可独立 source）
TB_LOOP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---------- gemma4 / 端侧模型服务（M4 上跑的 OpenAI 兼容 server） ----------
# llama.cpp server / TurboFieldfare 的 OpenAI 兼容端点。
# 任务容器通过 host.docker.internal 访问宿主 M4（Docker Desktop for Mac 默认支持）。
TB_GEMMA4_BASE_URL="http://host.docker.internal:1234/v1"
TB_GEMMA4_API_KEY="sk-local"
TB_GEMMA4_MODEL="gemma-4-26b-a4b-it"

# prime-agent 侧 provider 前缀：tb_loop/harness/extensions/gemma4-provider.ts 注册为 local-gemma4
TB_MODEL_PREFIX="local-gemma4"
TB_MODEL_PATTERN="${TB_MODEL_PREFIX}/${TB_GEMMA4_MODEL}"

# ---------- prime-agent autonomous 运行预算 ----------
TB_MAX_TURNS=12
TB_MAX_TOKENS=30000
TB_TIMEOUT_MS=600000
TB_MAX_CONTINUATIONS=3

# ---------- Terminal-Bench 数据集 ----------
TB_DATASET="terminal-bench-core==0.1.1"
# 每轮跑的任务：留空 = 全部；可填单个 task-id 或 glob（如 "hello-world,set-up-my-environment"）
TB_TASK_IDS=""
# 每轮跑前 N 个任务（学习循环建议先小批量）
TB_N_TASKS=10
TB_N_CONCURRENT=1

# ---------- 学习循环 ----------
TB_ROUNDS=2
# 每轮 refine 最多处理多少个失败任务（harness 提炼规模）
TB_MAX_REFINE_FAILURES=5

# ---------- freebuff2api（codebuff agent）轨迹生成 / SFT 数据 ----------
# freebuff2api 服务地址：在跑这个服务的机器上（例：Windows 本机 127.0.0.1:8000；
# M4 上跑 tb 时填那台机器的局域网 IP，如 http://192.168.1.10:8000/v1）
SFT_API_BASE_URL="http://127.0.0.1:1234/v1"
# 注意：必须等于 freebuff2api 项目 .env 里的 FREEBUFF_API_KEY（本地调用鉴权用）。
# 自动从代理 .env 读取（POSIX 兼容写法，BSD grep 没有 -P）；Windows 项目路径不存在
# 时（如 M4）回退到环境变量 SFT_API_KEY（跑之前 export 即可）。
_FREEBUFF_ENV="${TB_LOOP_DIR}/../app/cloud/freebuff2api/.env"
if [[ -f "$_FREEBUFF_ENV" ]]; then
SFT_API_KEY="local"
else
    SFT_API_KEY="${SFT_API_KEY:-}"
fi
unset _FREEBUFF_ENV
SFT_MODEL="Qwen3.6-35B-A3B-UD-IQ3_XXS.gguf"
# 每个任务 agent 最多迭代步数 / 单次回复最大 token
SFT_MAX_STEPS=20
SFT_MAX_TOKENS=4096
# 生成多少任务的成功轨迹
SFT_N_TASKS=10
# 数据集输出目录（相对 tb_loop）
SFT_DATA_DIR="${TB_LOOP_DIR}/sft_data"

# ---------- 路径（一般不用改） ----------
TB_VENV_PY="${TB_LOOP_DIR}/.venv/bin/python"
TB_TB_BIN="${TB_LOOP_DIR}/.venv/bin/tb"
TB_PRIME_AGENT_BIN="prime-agent"
TB_HARNESS_DIR="${TB_LOOP_DIR}/harness"
TB_RESULTS_DIR="${TB_LOOP_DIR}/results"

# ---------- MLX LoRA 微调（M4） ----------
# M4 上的 gemma4 模型：本地 MLX 权重目录或 HF repo（如 mlx-community/gemma-4-26B-A4B-it-4bit）
MLX_MODEL="${MLX_MODEL:-mlx-community/gemma-4-26B-A4B-it-4bit}"
# base / ft 两个 OpenAI 兼容服务的端口（ft 挂 LoRA 适配器）
MLX_BASE_PORT=1234
MLX_FT_PORT=1235
# LoRA 训练参数（26B A4B MoE、4 条轨迹的小数据集：小步长、少 iters）
MLX_LORA_LAYERS=8
MLX_BATCH_SIZE=1
MLX_ITERS=100
MLX_LR=1e-5
MLX_STEPS_PER_REPORT=10
MLX_STEPS_PER_EVAL=10
MLX_SAVE_EVERY=50

# 是否保留失败轨迹作为反例（1=开；开时 build_sft_dataset 会带 --include-failed）
SFT_INCLUDE_FAILED=0

# ---------- /refine 蒸馏 ----------
# 蒸馏模型：freebuff-codebuff/<SFT_MODEL>（freebuff2api 的 codebuff 云端模型，
# 质量高于端侧 gemma4 自蒸馏；端点不可达时 refine_harness.sh 自动回退本地模型）
TB_REFINE_MODEL_PATTERN="freebuff-codebuff/${SFT_MODEL}"
# 喂给 /refine 的每个轨迹源（commands.txt / panes）最大字符数；轨迹摘要最大条数
TB_REFINE_MAX_CHARS=6000
TB_REFINE_MAX_TRAJ=6

# ---------- 教训级归因 ----------
# 归因最少观测数（低于此数不采信，防单任务噪声）；RUN_ROLLBACK=1 才自动回滚有害条目
TB_MIN_OBSERVATIONS=2
RUN_ROLLBACK=0

# asciinema 录制解析：输入时间线条数上限；相邻输入停顿>=此秒数标为疑似卡住
TB_REFINE_MAX_CAST_INPUTS=40
TB_REFINE_STALL_SEC=30

# 终端观察滑窗（CodebuffApiAgent）：OBS_WINDOW=对话窗口步数（超过的压缩成命令摘要）；
# OBS_INCREMENTAL=1 时只发上一步新增输出（省 60%+ input token，但模型看不到早期输出，
# 需真实 API 验证行为后再开，默认关）
