{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cgc.agent_execution.v1",
  "title": "CGC Agent Execution Alias",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "suite_name",
    "total_tasks",
    "submitted_tasks",
    "passed_tasks",
    "resolved_instances",
    "resolution_rate",
    "result_semantics",
    "refs"
  ],
  "properties": {
    "schema_version": {
      "const": "cgc.agent_execution.v1"
    },
    "status": {
      "type": "string"
    },
    "suite_name": {
      "type": "string"
    },
    "total_tasks": {
      "type": "integer",
      "minimum": 0
    },
    "submitted_tasks": {
      "type": "integer",
      "minimum": 0
    },
    "passed_tasks": {
      "type": "integer",
      "minimum": 0
    },
    "resolved_instances": {
      "type": "integer",
      "minimum": 0
    },
    "resolution_rate": {
      "type": "number",
      "minimum": 0
    },
    "result_semantics": {
      "type": "string"
    },
    "artifact_index_path": {
      "type": "string"
    },
    "refs": {
      "type": "object",
      "required": [
        "formal_summary_ref",
        "system_profile_ref",
        "manifest_ref"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
