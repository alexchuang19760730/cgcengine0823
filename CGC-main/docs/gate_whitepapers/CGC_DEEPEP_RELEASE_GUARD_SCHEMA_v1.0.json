{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cgc.deepep_release_guard.v1",
  "title": "CGC DeepEP Release Guard Alias",
  "type": "object",
  "required": [
    "schema_version",
    "release_claim_status",
    "freshness_guard",
    "runtime_protocol_contract",
    "deepep_real_chain_gate",
    "refs"
  ],
  "properties": {
    "schema_version": {
      "const": "cgc.deepep_release_guard.v1"
    },
    "release_claim_status": {
      "type": "string"
    },
    "freshness_guard": {
      "type": "object",
      "required": [
        "status",
        "moe_a2a_backend",
        "backend_available",
        "task_type_contract_validation_status",
        "profile_settings_path"
      ],
      "additionalProperties": true
    },
    "runtime_protocol_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "deepep_real_chain_gate": {
      "type": "object",
      "additionalProperties": true
    },
    "refs": {
      "type": "object",
      "required": [
        "fresh_host1_probe_ref",
        "profile_settings_ref",
        "runtime_protocol_contract_ref",
        "system_profile_ref"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
