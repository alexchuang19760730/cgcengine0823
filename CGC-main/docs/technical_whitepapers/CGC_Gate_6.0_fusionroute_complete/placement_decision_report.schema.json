{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cgc://gate6/fusionroute/placement_decision_report.schema.json",
  "title": "FusionRoute Placement Decision Report",
  "description": "Schema for machine-readable placement decision reports generated by the Gate 6.0 FusionRoute role locality / placement draft projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "task_type",
    "gate_domain",
    "primary_role",
    "secondary_roles",
    "selected_locality",
    "runtime_endpoint",
    "decision_reason",
    "policy_source",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fusionroute.placement_decision_report.v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "gate_domain": {
      "type": "string",
      "enum": [
        "agent_runtime",
        "coding_runtime",
        "embodied_capability",
        "offline_synthesis"
      ]
    },
    "primary_role": {
      "type": "string",
      "minLength": 1
    },
    "secondary_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_locality": {
      "type": "string",
      "enum": [
        "cloud",
        "edge",
        "hybrid",
        "auto"
      ]
    },
    "runtime_endpoint": {
      "type": "string",
      "minLength": 1
    },
    "decision_reason": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_source": {
      "type": "string",
      "minLength": 1
    },
    "handoff_contract": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PENDING"
      ]
    },
    "evidence_path": {
      "type": "string"
    }
  }
}
