{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cgc://gate6/fusionroute/contract_projection_report.schema.json",
  "title": "Perception Matrix Contract Projection Report",
  "description": "Schema for contract-valid projection reports produced after the Perception Matrix policy suggestion is constrained by system profile, profile binding, bootstrap, state ABI, and topology contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "policy_suggestion_ref",
    "system_profile_id",
    "profile_binding_id",
    "selected_runtime_endpoint",
    "topology_profile",
    "bootstrap_profile",
    "state_abi_mode",
    "projection_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "perception_matrix.contract_projection_report.v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_suggestion_ref": {
      "type": "string",
      "minLength": 1
    },
    "system_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_binding_id": {
      "type": "string",
      "minLength": 1
    },
    "selected_runtime_endpoint": {
      "type": "string",
      "minLength": 1
    },
    "topology_profile": {
      "type": "string",
      "minLength": 1
    },
    "bootstrap_profile": {
      "type": "string",
      "minLength": 1
    },
    "state_abi_mode": {
      "type": "string",
      "minLength": 1
    },
    "pipeline_kernel_mode": {
      "type": "string"
    },
    "selected_gate_domain": {
      "type": "string"
    },
    "selected_primary_role": {
      "type": "string"
    },
    "selected_secondary_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projection_reason": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projection_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PENDING"
      ]
    }
  }
}
