{
  "schema_version": "runtime_bootstrap_contract_v1",
  "bootstrap_contract_id": "dualnode_blackwell_deepep_ep16_tp1_runtime_v1",
  "environment": "cloud_cluster",
  "runtime_profile": "dualnode_blackwell_sglang_deepep",
  "requested_dispatch_backend": "deepep",
  "requested_distributed_runtime": "nccl",
  "requested_storage_backend": "nfs_shared",
  "task_type_contract_ref": {
    "task_type_contract_version": "task_type_contract_v1",
    "task_type_contract_path": "/Users/alexchuang/Documents/flashkv0516/app/shared/contracts/task_type_contract.json",
    "task_type_header": "x-cgc-task-type",
    "known_task_types": [
      "prefill",
      "decode",
      "inference",
      "analysis",
      "repo_debug",
      "train"
    ]
  },
  "capability_summary": {
    "topology": "dualnode_16gpu",
    "gpu_arch": "sm120",
    "deep_gemm_available": false,
    "speculative_algorithm": "DFLASH",
    "deepep_parallel_profile": "ep16_tp1",
    "pp_size_supported_for_dflash": 1
  },
  "runtime_defaults": {
    "extra_args": [
      "--tp-size",
      "1",
      "--ep-size",
      "16",
      "--nnodes",
      "2",
      "--moe-a2a-backend",
      "deepep",
      "--deepep-mode",
      "normal"
    ],
    "env": {
      "CGC_DEEPEP_PARALLEL_PROFILE": "ep16_tp1",
      "CGC_DEEPEP_EP_SIZE": "16",
      "CGC_DEEPEP_TP_SIZE": "1",
      "CGC_SGLANG_TP_SIZE": "1",
      "CGC_SGLANG_EP_SIZE": "16",
      "CGC_SGLANG_NNODES": "2",
      "CGC_SGLANG_DISABLE_FP8_CPU_PIN_MEMORY": "1",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True"
    },
    "cleanup_policy": {
      "pkill_patterns_by_port": true,
      "release_parent_cuda_memory": true,
      "sleep_after_cleanup_s": 2.0
    }
  },
  "patch_policy": {
    "apply_fp8_cpu_staging_patch": true
  },
  "compatibility_rules": [
    {
      "rule_id": "sm120_deepep_normal",
      "when": {
        "gpu_arch": "sm120"
      },
      "effect": "force_deepep_mode_normal"
    },
    {
      "rule_id": "dualnode_ep16_tp1",
      "when": {
        "topology": "dualnode_16gpu"
      },
      "effect": "force_deepep_parallel_profile_ep16_tp1"
    },
    {
      "rule_id": "cpu_offload_disable_fp8_pin_memory",
      "when": {
        "cpu_offload_gb_gt_zero": true
      },
      "effect": "disable_fp8_cpu_pin_memory_staging"
    },
    {
      "rule_id": "dflash_pp_single_stage",
      "when": {
        "speculative_algorithm": "DFLASH"
      },
      "effect": "require_pp_size_eq_1"
    }
  ],
  "notes": [
    "This bootstrap contract formalizes the dual-node DeepEP ep16/tp1 deployment baseline for vendored SGLang.",
    "It does not bypass the current DeepSeek-V4 model-layer blocker; wqkv_a and legacy_kv compatibility still needs a runtime bridge."
  ]
}
