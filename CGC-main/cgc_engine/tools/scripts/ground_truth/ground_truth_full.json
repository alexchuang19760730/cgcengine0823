{
  "ggml_legacy": {
    "TILE_M": 32,
    "TILE_N": 32,
    "TILE_K": 32,
    "simd_width": 32,
    "unroll_factor": 4,
    "attn_block_size": 64,
    "fuse_qkv_rope_attn": true,
    "fuse_mlp_silu": true,
    "mem_align_bytes": 64,
    "quant_block_size": 32
  },
  "backends": {
    "llama_cpp_metal": {
      "device": "metal",
      "source": "ggml-metal.metal",
      "compute": {
        "tile_m": 32,
        "tile_n": 32,
        "tile_k": 32,
        "simd_width": 32,
        "unroll": 4,
        "fusion": [
          "qkv_proj + rope + attn_norm + attention",
          "mlp_up + silu + mlp_down"
        ]
      },
      "storage": {
        "weight_layout": "row-major (ggml)",
        "kv_layout": "BSHN",
        "mem_align": 64,
        "quant_block": 32,
        "memory_pool": true,
        "scratch_buffer_reuse": true,
        "no_realloc": true
      },
      "device_io": {
        "metal_zero_copy": true,
        "upload_weights_once": true,
        "sync_only_at_commit": true,
        "keep_weights_in_gpu": true
      },
      "scheduler": {
        "batch_size": 1,
        "continuous_batching": false,
        "prefix_caching": false,
        "paged_attention": false,
        "context_shift": true,
        "kv_cache_reuse": false
      }
    },
    "vllm_cuda": {
      "device": "cuda",
      "source": "vllm/src/scheduler + kernels",
      "compute": {
        "tile_m": 128,
        "tile_n": 128,
        "tile_k": 32,
        "simd_width": 32,
        "unroll": 4,
        "fusion": [
          "qkv_proj + rope + paged_attention",
          "mlp_up + gelu + mlp_down"
        ]
      },
      "storage": {
        "weight_layout": "row-major",
        "kv_layout": "BSNH padded blocks",
        "mem_align": 128,
        "quant_block": 32,
        "paged_kv_cache": true,
        "block_size": 16,
        "memory_pool": true
      },
      "device_io": {
        "pinned_memory": true,
        "cuda_memcpy_async": true,
        "overlap_data_transfer": true,
        "stream_queued": true,
        "host_device_coherence": false
      },
      "scheduler": {
        "continuous_batching": true,
        "dynamic_batch_size": true,
        "prefix_caching": true,
        "paged_attention": true,
        "max_num_batched_tokens": 2048,
        "preemptive_swap": true,
        "eviction_policy": "lru",
        "kv_cache_reuse": true
      }
    },
    "kimi_kda": {
      "device": [
        "metal",
        "cuda"
      ],
      "source": "Kimi 論文 + FlashLinearAttention",
      "compute": {
        "tile_m": 64,
        "tile_n": 64,
        "tile_k": 64,
        "chunk_size": 128,
        "beta": 0.1,
        "fusion": [
          "qkv_proj + kda_recurrent_update + kda_apply"
        ]
      },
      "storage": {
        "state_in_l1": true,
        "kv_layout": "chunked BSHN"
      },
      "device_io": {
        "zero_copy": true,
        "state_always_in_gpu": true
      },
      "scheduler": {
        "chunked_recurrent": true,
        "no_attention_matrix": true,
        "state_reuse": true
      }
    }
  }
}